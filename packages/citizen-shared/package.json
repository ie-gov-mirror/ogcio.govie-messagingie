{
  "name": "@citizen-portal/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared cross-zone helpers for the citizen-portal app: SAG provider, useCrossZoneLink, env schema, theme, i18n, faro, analytics.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./env": {
      "types": "./src/env/define.ts",
      "default": "./src/env/define.ts"
    }
  },
  "scripts": {
    "format": "biome check --write",
    "test": "vitest run --reporter=junit --outputFile=results.xml || exit 0",
    "test:local": "vitest"
  },
  "dependencies": {
    "@ogcio/sag-client": "0.7.12",
    "@t3-oss/env-nextjs": "0.13.11",
    "zod": "4.6.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "jsdom": "^30.0.1",
    "vitest": "5.0.0"
  }
}
