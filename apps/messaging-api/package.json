{
  "name": "messaging-api",
  "version": "1.2.1",
  "description": "",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "NODE_OPTIONS='--import tsx' vitest run --reporter junit --reporter default --coverage --outputFile=results.xml",
    "test:local": "NODE_OPTIONS='--import tsx' vitest",
    "test:e2e": "cd ./e2e && bru run --env local",
    "test:smoke:e2e": "cd ./e2e && mkdir -p test-results && bru run --env dev --output ./test-results/results.xml --format junit",
    "test:regression:e2e": "cd ./e2e && mkdir -p test-results && bru run --env dev --output ./test-results/results.xml --format junit",
    "dev": "FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --watch --import tsx --env-file .env src/index.ts | pino-pretty",
    "start": "node --env-file=.env --import ./dist/instrumentation.js dist/index.js",
    "verify-smtp": "tsx ./src/scripts/verify-smtp/index.ts",
    "pii-hash": "tsx ./src/scripts/pii-hash/index.ts",
    "send-message-batches": "tsx --env-file=./src/scripts/send-message-batches/.env ./src/scripts/send-message-batches/entry-console.ts",
    "send-message-batches:pino": "tsx --env-file=./src/scripts/send-message-batches/.env ./src/scripts/send-message-batches/entry-pino.ts",
    "reproduce-export-leak": "tsx ./src/scripts/reproduce-export-leak/entry-console.ts",
    "format": "biome check --write",
    "lint": "biome check",
    "build": "rm -rf dist && tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json && cp -R src/public dist/public && cp -R src/migrations/sql dist/migrations/sql && cp -R src/certificates dist/certificates",
    "db:create": "tsx --env-file=.env ./src/migrations/scripts/run-create-database.ts",
    "db:drop": "tsx --env-file=.env ./src/migrations/scripts/run-drop-database.ts",
    "db:migrate": "tsx --env-file=.env ./src/migrations/scripts/run-migrate-database.ts",
    "sync-event-summary": "tsx --env-file=.env ./src/migrations/scripts/run-sync-event-summary.ts",
    "sync-event-summary:full-resync": "tsx --env-file=.env ./src/migrations/scripts/run-sync-event-summary.ts -- --full-resync",
    "db:rollback": "tsx --env-file=.env ./src/migrations/scripts/run-migrate-database.ts -- version=0",
    "db:create-ci": "node ./dist/migrations/scripts/run-create-database.js",
    "db:migrate-ci": "node ./dist/migrations/scripts/run-migrate-database.js",
    "sync-event-summary-ci": "node ./dist/migrations/scripts/run-sync-event-summary.js",
    "sync-event-summary-ci:full-resync": "node ./dist/migrations/scripts/run-sync-event-summary.js -- --full-resync"
  },
  "type": "module",
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1131.0",
    "@aws-sdk/client-sns": "3.1131.0",
    "@cacheable/node-cache": "3.1.1",
    "@fastify/autoload": "6.5.0",
    "@fastify/env": "7.0.0",
    "@fastify/otel": "0.21.0",
    "@fastify/postgres": "6.1.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/under-pressure": "9.1.0",
    "@ogcio/api-auth": "6.0.0",
    "@ogcio/building-blocks-sdk": "0.2.110",
    "@ogcio/fastify-error-handler": "5.4.0",
    "@ogcio/fastify-logging-wrapper": "5.5.2",
    "@ogcio/fastify-o11y": "5.2.4",
    "@ogcio/o11y-sdk-node": "0.14.1",
    "@ogcio/pii-utils": "0.1.0",
    "@ogcio/shared-errors": "1.2.2",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.4",
    "fastify-plugin": "6.0.0",
    "http-errors": "2.0.1",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.13",
    "node-polyglot": "2.6.0",
    "nodemailer": "10.0.9",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "postgrator": "8.0.0",
    "typebox": "1.3.30",
    "unleash-client": "6.12.1",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/http-errors": "2.0.5",
    "@types/node-polyglot": "2.5.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@usebruno/cli": "4.1.0",
    "@vitest/coverage-v8": "5.0.0",
    "commander": "15.0.0",
    "pino-pretty": "13.1.3",
    "@types/sanitize-html": "2.16.1"
  }
}
