meta {
  name: Get Public Servant Token
  type: http
  seq: 2
}

post {
  url: {{logtoApiUrl}}/oidc/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
  Authorization: Basic {{process.env.BRUNO_PS_BASIC_M2M_TOKEN}}
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: upload:file:*
  organization_id: first-testing
}

vars:post-response {
  uploadPublicServantAccessToken: res.body.access_token
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

docs {
  Organisation token of the public servant M2M app: citizens hold no organisation roles.
}
