meta {
  name: Create message
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/messages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

vars:post-response {
  messageSubject: req.body.message.subject
  ~createMessageId: res.body.data.id
}

assert {
  res.body.data.id: isDefined
  res.status: eq 201
}

script:pre-request {
  const uuid = require("uuid")
  const messageSubject = uuid.v4()
  bru.setVar("messageSubject", messageSubject)

  const scheduleAt = "2024-08-26T10:05:04.865Z"
  bru.setVar("messageScheduleDate", scheduleAt.slice(0, 10))

  req.setBody({
    "preferredTransports": ["lifeEvent"],
    "recipientUserId": bru.getVar("importedUserId"),
    "security": "public",
    "scheduleAt": scheduleAt,
    "message": {
      "threadName": "threadName",
      "subject": messageSubject,
      "excerpt": "excerpt",
      "plainText": "plainText",
      "richText": "richText",
      "language": "en"
    }
  })
}
