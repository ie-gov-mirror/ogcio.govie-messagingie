meta {
  name: Find created message event
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/message-events?search={{messageSubject}}&dateFrom={{messageScheduleDate}}
  body: none
  auth: bearer
}

params:query {
  search: {{messageSubject}}
  dateFrom: {{messageScheduleDate}}
}

auth:bearer {
  token: {{accessToken}}
}

vars:post-response {
  eventId: res.body.data.at(0).id
  sentMessageId: res.body.data.at(0).messageId
  messageSubject: res.body.data.at(0).subject
}

assert {
  res.body: isJson
  res.status: eq 200
  res.body.data.length: gt 0
}

docs {
  `dateFrom`: the event search only covers the last 30 days unless given a start date
}
