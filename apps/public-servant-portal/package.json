{
  "name": "public-servant-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PORT=4002 next dev",
    "dev:debug": "DEBUG=next:* next dev",
    "build": "next build",
    "build:prod": "node scripts/build-with-prod-tsconfig.mjs",
    "start": "npx serve out -p 4002",
    "typegen": "next typegen",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "vitest run --coverage --reporter=junit --outputFile=results.xml",
    "test:local": "vitest",
    "test:e2e:local": "playwright test",
    "test:e2e:lighthouse": "playwright test e2e/lighthouse --workers 1",
    "test:e2e:local:messaging": "BASE_URL=http://messaging-admin.local.test:8080 playwright test",
    "test:e2e:local:profile": "BASE_URL=http://profile-admin.local.test:8080 playwright test",
    "test:e2e:dev": "BASE_URL=https://messaging-admin.dev.services.gov.ie ADMIN_URL=https://messaging-admin.dev.services.gov.ie AUTH_URL=https://authorization.dev.services.gov.ie/sign-in playwright test  --workers 1",
    "test:e2e:dev:ui": "npm run test:e2e:dev -- --ui",
    "test:smoke:e2e": "BASE_URL=https://messaging-admin.dev.services.gov.ie ADMIN_URL=https://messaging-admin.dev.services.gov.ie AUTH_URL=https://authorization.dev.services.gov.ie/sign-in playwright test --grep '@smoke' --workers 1",
    "test:regression:e2e": "BASE_URL=https://messaging-admin.dev.services.gov.ie ADMIN_URL=https://messaging-admin.dev.services.gov.ie AUTH_URL=https://authorization.dev.services.gov.ie/sign-in playwright test --grep '@regression|@smoke|@visual' --workers 1"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "0.9.0",
    "@grafana/faro-web-sdk": "2.11.0",
    "@ogcio/analytics-sdk": "0.2.19",
    "@ogcio/design-system-react": "1.42.0",
    "@ogcio/nextjs-analytics": "1.0.1",
    "@ogcio/o11y-sdk-react": "0.12.4",
    "@ogcio/sag-client": "0.7.12",
    "@ogcio/theme-govie": "1.21.7",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-table": "8.21.3",
    "@unleash/proxy-client-react": "6.0.1",
    "dayjs": "1.11.23",
    "next": "16.3.5",
    "next-intl": "4.14.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "2.5.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "axe-html-reporter": "2.2.11",
    "gmail-getter": "2.4.0",
    "jsdom": "30.0.1",
    "lighthouse": "13.4.1",
    "playwright": "1.63.0",
    "playwright-lighthouse": "4.0.0",
    "vitest": "5.0.0"
  }
}
