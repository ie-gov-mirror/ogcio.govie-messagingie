FROM base-deps AS public-servant-portal-base-deps

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM public-servant-portal-base-deps AS builder
WORKDIR /app

# Copy dependency files for better layer caching
COPY package.json pnpm-*.yaml /app/
COPY patches/ /app/patches/

# Workspace package.json files needed before `pnpm install` so pnpm can
# resolve the workspace graph from manifests alone.
COPY apps/public-servant-portal/package.json /app/apps/public-servant-portal/package.json

RUN apk update && \
    apk upgrade && \
    apk add envsubst

# Install dependencies with cache mount for faster builds
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy source for the unified app.
COPY ./apps/public-servant-portal/ /app/apps/public-servant-portal/

ENV NODE_ENV=production
ENV CI=true

ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_SAG_URL
ARG NEXT_PUBLIC_MESSAGING_URL
ARG NEXT_PUBLIC_PROFILE_URL
ARG NEXT_PUBLIC_MESSAGING_ADMIN_SERVICE_ENTRY_POINT
ARG NEXT_PUBLIC_PROFILE_ADMIN_SERVICE_ENTRY_POINT
ARG NEXT_PUBLIC_UNLEASH_URL
ARG NEXT_PUBLIC_UNLEASH_CLIENT_KEY
ARG NEXT_PUBLIC_UNLEASH_APP_NAME
ARG NEXT_PUBLIC_FARO_URL
ARG NEXT_PUBLIC_FARO_SERVICE_NAME
ARG NEXT_PUBLIC_FARO_SERVICE_NAMESPACE
ARG NEXT_PUBLIC_FARO_PROPAGATE_TRACE_HEADER

ARG NEXT_PUBLIC_ANALYTICS_WEBSITE_ID
ARG NEXT_PUBLIC_ANALYTICS_ORGANIZATION_ID=ogcio
ARG NEXT_PUBLIC_ANALYTICS_DRY_RUN="true"

# Defaults match docker-compose.yaml /etc/hosts setup — both admin
# hostnames are served from THIS same container on port 8080 via the
# unified nginx server block.
ENV NEXT_PUBLIC_BASE_URL=${NEXT_PUBLIC_BASE_URL:-http://messaging-admin.local.test:8080}
ENV NEXT_PUBLIC_SAG_URL=${NEXT_PUBLIC_SAG_URL:-http://sag.local.test:3333}
ENV NEXT_PUBLIC_MESSAGING_URL=${NEXT_PUBLIC_MESSAGING_URL:-http://messaging.local.test:8080}
ENV NEXT_PUBLIC_PROFILE_URL=${NEXT_PUBLIC_PROFILE_URL:-http://profile.local.test:8080}
ENV NEXT_PUBLIC_MESSAGING_ADMIN_URL=${NEXT_PUBLIC_MESSAGING_ADMIN_SERVICE_ENTRY_POINT:-http://messaging-admin.local.test:8080}
ENV NEXT_PUBLIC_PROFILE_ADMIN_URL=${NEXT_PUBLIC_PROFILE_ADMIN_SERVICE_ENTRY_POINT:-http://profile-admin.local.test:8080}
ENV NEXT_PUBLIC_UNLEASH_URL=${NEXT_PUBLIC_UNLEASH_URL:-http://localhost:4242/api/frontend}
ENV NEXT_PUBLIC_UNLEASH_CLIENT_KEY=${NEXT_PUBLIC_UNLEASH_CLIENT_KEY:-default:development.unleash-insecure-frontend-api-token}
ENV NEXT_PUBLIC_UNLEASH_APP_NAME=${NEXT_PUBLIC_UNLEASH_APP_NAME:-public-servant-portal}
ENV NEXT_PUBLIC_FARO_URL=${NEXT_PUBLIC_FARO_URL:-http://localhost:12347/collect}
ENV NEXT_PUBLIC_FARO_SERVICE_NAME=${NEXT_PUBLIC_FARO_SERVICE_NAME:-public-servant-portal}
ENV NEXT_PUBLIC_FARO_SERVICE_NAMESPACE=${NEXT_PUBLIC_FARO_SERVICE_NAMESPACE:-messaging}
ENV NEXT_PUBLIC_FARO_PROPAGATE_TRACE_HEADER=${NEXT_PUBLIC_FARO_PROPAGATE_TRACE_HEADER:-http://messaging-admin.local.test:8080/*}

ENV NEXT_PUBLIC_ANALYTICS_URL=${NEXT_PUBLIC_BASE_URL:-http://messaging-admin.local.test:8080}/_next/analytics-api
ENV NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=${NEXT_PUBLIC_ANALYTICS_WEBSITE_ID}
ENV NEXT_PUBLIC_ANALYTICS_ORGANIZATION_ID=${NEXT_PUBLIC_ANALYTICS_ORGANIZATION_ID}
ENV NEXT_PUBLIC_ANALYTICS_DRY_RUN=${NEXT_PUBLIC_ANALYTICS_DRY_RUN:-true}

ARG PORT
ARG OTEL_ENABLE
ARG OTEL_SERVICE_NAME
ARG OTEL_COLLECTOR_URL

ENV PORT=${PORT:-8080}
ENV OTEL_ENABLE=${OTEL_ENABLE:-false}
ENV OTEL_SERVICE_NAME=${OTEL_SERVICE_NAME:-public-servant-portal}
ENV OTEL_COLLECTOR_URL=${OTEL_COLLECTOR_URL:-http://localhost:1234}

ARG TRUSTED_PROXY_CIDR
ENV TRUSTED_PROXY_CIDR=${TRUSTED_PROXY_CIDR:-0.0.0.0/0}

# Per-zone server_name values for the canonicalisation map — defaults
# match docker-compose.yaml /etc/hosts setup.
ARG MESSAGING_ADMIN_HOST
ARG PROFILE_ADMIN_HOST
ENV MESSAGING_ADMIN_HOST=${MESSAGING_ADMIN_HOST:-messaging-admin.local.test}
ENV PROFILE_ADMIN_HOST=${PROFILE_ADMIN_HOST:-profile-admin.local.test}

ARG ANALYTICS_MANAGEMENT_API_ORIGIN=http://localhost:8075
ARG ANALYTICS_MANAGEMENT_API_HOST=localhost:8075
ENV ANALYTICS_MANAGEMENT_API_ORIGIN=${ANALYTICS_MANAGEMENT_API_ORIGIN}
ENV ANALYTICS_MANAGEMENT_API_HOST=${ANALYTICS_MANAGEMENT_API_HOST}

ARG ANALYTICS_TRACKER_ORIGIN=https://track.analytics.dev.services.gov.ie
ENV ANALYTICS_TRACKER_ORIGIN=${ANALYTICS_TRACKER_ORIGIN}

ARG UNLEASH_FRONTEND_ORIGIN=http://localhost:4242
ARG UNLEASH_FRONTEND_HOST=localhost:4242
ARG UNLEASH_FRONTEND_TOKEN=default:development.unleash-insecure-frontend-api-token
ENV UNLEASH_FRONTEND_ORIGIN=${UNLEASH_FRONTEND_ORIGIN}
ENV UNLEASH_FRONTEND_HOST=${UNLEASH_FRONTEND_HOST}
ENV UNLEASH_FRONTEND_TOKEN=${UNLEASH_FRONTEND_TOKEN}

ENV CSP_CONNECT_SRC="${NEXT_PUBLIC_SAG_URL} ${NEXT_PUBLIC_FARO_URL} ${NEXT_PUBLIC_UNLEASH_URL} ${NEXT_PUBLIC_ANALYTICS_URL}"

# Build the unified public-servant-portal app (single out/).
RUN pnpm --filter public-servant-portal build

# Prune dev dependencies for production
RUN pnpm prune --prod

# Pre-compress static assets at max level for gzip_static serving.
RUN find \
    /app/apps/public-servant-portal/out \
    -type f \( -name '*.html' -o -name '*.css' -o -name '*.js' -o -name '*.json' -o -name '*.svg' -o -name '*.xml' -o -name '*.txt' \) \
    -exec gzip -k -9 {} +

RUN envsubst '${OTEL_ENABLE} ${OTEL_SERVICE_NAME} ${OTEL_COLLECTOR_URL} ${PORT} ${TRUSTED_PROXY_CIDR} ${CSP_CONNECT_SRC} ${ANALYTICS_MANAGEMENT_API_ORIGIN} ${ANALYTICS_MANAGEMENT_API_HOST} ${ANALYTICS_TRACKER_ORIGIN} ${MESSAGING_ADMIN_HOST} ${PROFILE_ADMIN_HOST} ${UNLEASH_FRONTEND_ORIGIN} ${UNLEASH_FRONTEND_HOST} ${UNLEASH_FRONTEND_TOKEN} ${NEXT_PUBLIC_SAG_URL}' <"/app/apps/public-servant-portal/docker/nginx.conf.template" > "/app/apps/public-servant-portal/docker/nginx.conf"

# Production stage
FROM nginxinc/nginx-unprivileged:1.31-alpine-otel AS runner

USER root

# Remove default site
RUN rm /etc/nginx/conf.d/default.conf

# Single root for both admin hostnames.
COPY --from=builder /app/apps/public-servant-portal/out/         /usr/share/nginx/html/
COPY --from=builder /app/apps/public-servant-portal/docker/nginx.conf  /etc/nginx/nginx.conf

# Generate the nginx resolver from the container's DNS at start (runtime DNS re-resolution).
COPY --from=builder /app/apps/public-servant-portal/docker/15-resolver.sh /docker-entrypoint.d/15-resolver.sh
RUN chmod +x /docker-entrypoint.d/15-resolver.sh

ARG PORT
ENV PORT=${PORT:-8080}
EXPOSE ${PORT}

USER nginx

CMD ["nginx", "-g", "daemon off;"]
