# ── Local-only override of secure-api-gateway's Dockerfile ───────────
#
# The upstream `apps/secure-api-gateway/Dockerfile` final runner stage
# uses a private AWS ECR image:
#
#   FROM 428528001781.dkr.ecr.eu-west-1.amazonaws.com/dhi.io/node:24-alpine3.24 AS runner
#
# Outside the OGCIO CI runners that's gated behind `aws ecr
# get-login-password` and AWS credentials, so a plain `docker build`
# from a contributor's laptop fails with "no basic auth credentials".
#
# This override mirrors the upstream Dockerfile verbatim but swaps the
# runner base to public `node:24-alpine`. The runtime contract (USER
# node, PORT 3333, the `node --import ./dist/instrumentation.js
# dist/index.js` CMD) stays identical, so the resulting image talks to
# Logto + Redis the same way the dev cluster's image does.
#
# IMPORTANT: keep this file in lockstep with
# `@ogcio/secure-api-gateway/apps/secure-api-gateway/Dockerfile`. If
# the upstream Dockerfile grows new build steps (extra COPY lines, new
# build-time env vars), mirror them here.
#
# Built by `docker-compose.local-auth.yaml`. The compose file passes
# `context: ${SAG_PATH}` (default: `../../../@ogcio/secure-api-gateway`)
# so this Dockerfile sees the SAG monorepo as its build context.

FROM base-deps AS app-base-deps

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI=true
RUN corepack enable

FROM app-base-deps AS builder
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY package.json ./
RUN mkdir -p /app/apps/secure-api-gateway
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm fetch

COPY apps/secure-api-gateway/package.json /app/apps/secure-api-gateway/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm install --filter @ogcio/secure-api-gateway --frozen-lockfile --offline

COPY apps/secure-api-gateway/tsconfig* /app/apps/secure-api-gateway/
COPY apps/secure-api-gateway/src /app/apps/secure-api-gateway/src

RUN pnpm --filter @ogcio/secure-api-gateway build
RUN pnpm deploy --filter @ogcio/secure-api-gateway --prod --legacy /app/apps/secure-api-gateway/deploy

# ── Runner — public Node, not the private ECR mirror ─────────────────
FROM node:24-alpine AS runner

WORKDIR /app/apps/secure-api-gateway

COPY --from=builder --chown=node:node /app/apps/secure-api-gateway/deploy/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/apps/secure-api-gateway/deploy/dist ./dist
COPY --from=builder --chown=node:node /app/apps/secure-api-gateway/deploy/package.json ./package.json

USER node

ARG PORT=3333
ENV NODE_ENV=production
ENV LOG_LEVEL=INFO
ENV PORT=$PORT

EXPOSE ${PORT}

CMD [ "node", "--import", "./dist/instrumentation.js", "dist/index.js" ]
