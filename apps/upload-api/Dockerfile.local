# Local-development variant of ./Dockerfile.
#
# Identical to the production Dockerfile except for the runner base image: this
# one uses the public `node:24-alpine3.24` instead of the hardened
# `dhi.io/node:24-alpine3.24` mirror in ECR, which needs AWS credentials most
# developers do not have locally.
#
# Keep this file in sync with ./Dockerfile. The ONLY line that should ever
# differ is the runner `FROM`. Anything else means local builds have stopped
# being a faithful proxy for what the pipeline produces.
#
#   docker build -f apps/upload-api/Dockerfile.local -t upload-api:local .
#
# Requires the `base-deps` stage to exist first: `pnpm docker:build:base`.

FROM base-deps AS upload-api-base-deps

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM upload-api-base-deps AS builder
WORKDIR /app

COPY ./pnpm*.yaml /app/
COPY ./package.json /app/
COPY ./patches/ /app/patches/
COPY ./apps/upload-api/ /app/apps/upload-api/
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile

RUN pnpm --filter upload-api run build

RUN pnpm deploy --filter=upload-api --prod /app/deploy

FROM node:24-alpine3.24 AS runner
WORKDIR /app

USER node

ARG PORT=8008

ENV NODE_ENV=production
ENV PORT=$PORT
ENV LOG_LEVEL=trace

COPY --from=builder --chown=node:node /app/deploy/dist /app/apps/upload-api/dist
COPY --from=builder --chown=node:node /app/deploy/node_modules /app/apps/upload-api/node_modules
COPY --from=builder --chown=node:node /app/deploy/package.json /app/apps/upload-api/

EXPOSE ${PORT}

WORKDIR /app/apps/upload-api

CMD [ "node", "--import", "./dist/instrumentation.js", "dist/index.js" ]
