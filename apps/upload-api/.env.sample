# Rate Limiting
# Optional: Maximum number of uploads allowed per IP address per minute, defaults to 250 if not set
# UPLOAD_LIMIT_PER_IP_PER_MINUTE=250

MAX_SUPPORT_FILE_SIZE_MB=1024

# Optional: set to false to disable the ClamAV scan on upload, defaults to true if not set
ANTIVIRUS_SCAN_ENABLED=true

# Upload Size Chunks Fine Tuning
CLAMAV_CHUNKS_NUMBER=4
CLAMAV_CHUNK_SIZE_KB=128
S3_CHUNKS_NUMBER=4
S3_CHUNK_SIZE_MB=5

# Postgres SSL
POSTGRES_SSL=false

