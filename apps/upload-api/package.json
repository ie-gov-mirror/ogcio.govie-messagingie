{
  "name": "upload-api",
  "version": "1.1.3",
  "description": "",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "NODE_OPTIONS='--import tsx' vitest run --reporter junit --reporter default --coverage --outputFile=results.xml",
    "test:local": "NODE_OPTIONS='--import tsx' vitest",
    "test:integration:clamav": "NODE_OPTIONS='--import tsx' vitest run --reporter default --config vitest.integration.config.mts src/test/utils/clamav/passthrough.integration.test.ts src/test/utils/clamav/getVersion.integration.test.ts",
    "test:e2e": "cd ./e2e && bru run --env local",
    "test:smoke:e2e": "cd ./e2e && mkdir -p test-results && bru run --env dev --output ./test-results/results.xml --format junit",
    "test:regression:e2e": "cd ./e2e && mkdir -p test-results && bru run --env dev --output ./test-results/results.xml --format junit",
    "test:k6": "sh ./k6/run-load-tests.sh",
    "test:k6:validate": "sh ./k6/run-load-tests.sh --validate",
    "start": "node --env-file=.env --import ./dist/instrumentation.js dist/index.js",
    "dev": "FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --watch --import tsx --import ./src/instrumentation.ts src/index.ts | pino-pretty",
    "format": "biome check --write",
    "lint": "biome check",
    "build": "rm -rf dist && tsc -p tsconfig.prod.json && cp src/logo.png dist/ && cp -R src/migrations/sql dist/migrations/sql && cp -R src/certificates dist/certificates",
    "migrate": "tsx --env-file=.env ./src/migrations/scripts/run-migrate-database.ts",
    "create-db": "tsx --env-file=.env ./src/migrations/scripts/run-create-database.ts",
    "db:create": "tsx --env-file=.env ./src/migrations/scripts/run-create-database.ts",
    "db:drop": "tsx --env-file=.env ./src/migrations/scripts/run-drop-database.ts",
    "db:migrate": "tsx --env-file=.env ./src/migrations/scripts/run-migrate-database.ts"
  },
  "type": "module",
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/client-secrets-manager": "3.1131.0",
    "@aws-sdk/lib-storage": "3.1131.0",
    "@cacheable/node-cache": "3.1.1",
    "@fastify/autoload": "6.5.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/env": "7.0.0",
    "@fastify/formbody": "9.0.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/otel": "0.21.0",
    "@fastify/postgres": "6.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/under-pressure": "9.1.0",
    "@ogcio/api-auth": "6.0.0",
    "@ogcio/building-blocks-sdk": "0.2.110",
    "@ogcio/fastify-error-handler": "5.4.0",
    "@ogcio/fastify-logging-wrapper": "5.5.2",
    "@ogcio/o11y-sdk-node": "0.14.1",
    "@ogcio/pii-utils": "0.1.0",
    "@ogcio/shared-errors": "1.2.2",
    "dotenv": "17.4.2",
    "fastify": "5.12.4",
    "fastify-plugin": "6.0.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "postgrator": "8.0.0",
    "typebox": "1.3.30"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@usebruno/cli": "4.1.0",
    "@vitest/coverage-v8": "5.0.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
