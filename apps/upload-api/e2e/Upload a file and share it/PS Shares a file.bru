meta {
  name: PS Shares a file
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/permissions
  body: formUrlEncoded
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:form-urlencoded {
  fileId: {{fileId}}
  userId: {{process.env.CITIZEN_USER_PROFILE_ID}}
}

assert {
  res.status: eq 201
  res.body.data.userId: eq {{process.env.CITIZEN_USER_PROFILE_ID}}
}
