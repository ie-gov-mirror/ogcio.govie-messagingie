{
  "name": "@govie-services/profile-api",
  "version": "0.1.2",
  "description": "Profile API",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node --env-file=.env --import ./dist/instrumentation.js dist/index.js",
    "dev": "FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --watch --import tsx --env-file .env src/index.ts | pino-pretty",
    "build": "rm -rf dist && tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json && cp -R src/public dist/public && cp -R src/migrations/sql dist/migrations/sql && cp -R src/certificates dist/certificates",
    "format": "biome check --write",
    "lint": "biome check",
    "test:local": "NODE_OPTIONS='--import tsx' vitest",
    "test": "NODE_OPTIONS='--import tsx' vitest run --reporter junit --reporter default --coverage --outputFile=results.xml",
    "test:e2e": "cd ./e2e && mkdir -p test-results && bru run --env dev --output ./test-results/results.xml --format junit --exclude-tags announcements",
    "test:e2e:local": "cd ./e2e && mkdir -p test-results && bru run --env local --output ./test-results/results.xml --format junit --exclude-tags announcements",
    "test:ci:e2e": "cd ./e2e && mkdir -p test-results && bru run --env dev --output ./test-results/results.xml --format junit  --exclude-tags announcements",
    "test:smoke:e2e": "pnpm run test:ci:e2e",
    "test:regression:e2e": "pnpm run test:ci:e2e",
    "db:create": "tsx --env-file=.env ./src/migrations/scripts/run-create-database.ts",
    "db:drop": "tsx --env-file=.env ./src/migrations/scripts/run-drop-database.ts",
    "db:migrate": "tsx --env-file=.env ./src/migrations/scripts/run-migrate-database.ts",
    "db:rollback": "tsx --env-file=.env ./src/migrations/scripts/run-migrate-database.ts -- version=0",
    "db:create-ci": "node ./dist/migrations/scripts/run-create-database.js",
    "db:migrate-ci": "node ./dist/migrations/scripts/run-migrate-database.js",
    "db:bootstrap": "npm run seed-consent-statements && npm run sync-profile-consents && npm run blacklist-profiles && npm run merge-ppsns",
    "db:bootstrap:ci": "npm run seed-consent-statements:ci && npm run sync-profile-consents:ci && npm run blacklist-profiles:ci && npm run merge-ppsns:ci",
    "blacklist-profiles": "tsx --env-file=.env ./src/migrations/scripts/run-blacklist-profiles.ts",
    "blacklist-profiles:ci": "node ./dist/migrations/scripts/run-blacklist-profiles.js",
    "sync-profile-consents": "tsx --env-file=.env ./src/migrations/scripts/run-sync-profile-consents.ts",
    "sync-profile-consents:ci": "node ./dist/migrations/scripts/run-sync-profile-consents.js",
    "seed-consent-statements": "tsx --env-file=.env ./src/migrations/scripts/run-seed-consent-statements.ts",
    "seed-consent-statements:ci": "node ./dist/migrations/scripts/run-seed-consent-statements.js",
    "merge-ppsns": "tsx --env-file=.env ./src/migrations/scripts/run-merge-ppsns.ts",
    "merge-ppsns:ci": "node ./dist/migrations/scripts/run-merge-ppsns.js",
    "lifecycle-worker": "tsx --env-file=.env ./src/scripts/lifecycle-worker/index.ts",
    "lifecycle-worker:ci": "node ./dist/scripts/lifecycle-worker/index.js",
    "preinstall": "npx only-allow pnpm",
    "pii-utils:seed-pepper": "tsx --env-file=.env ./src/scripts/seed-pii-hasher-pepper.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1131.0",
    "@cacheable/node-cache": "3.1.1",
    "@fastify/autoload": "6.5.0",
    "@fastify/busboy": "3.2.2",
    "@fastify/env": "7.0.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/otel": "0.21.0",
    "@fastify/postgres": "6.1.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/under-pressure": "9.1.0",
    "@logto/node": "3.1.10",
    "@ogcio/api-auth": "6.0.0",
    "@ogcio/building-blocks-sdk": "0.2.110",
    "@ogcio/fastify-error-handler": "5.4.0",
    "@ogcio/fastify-logging-wrapper": "5.5.2",
    "@ogcio/fastify-o11y": "5.2.4",
    "@ogcio/o11y-sdk-node": "0.14.1",
    "@ogcio/pii-utils": "0.1.0",
    "@ogcio/shared-errors": "1.2.2",
    "archiver": "8.0.0",
    "blacklist-profiles": "workspace:*",
    "close-with-grace": "2.5.0",
    "dayjs": "1.11.23",
    "fast-csv": "5.0.7",
    "fastify": "5.12.4",
    "fastify-plugin": "6.0.0",
    "fastify-raw-body": "6.0.1",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pg-query-stream": "4.17.0",
    "pino": "10.3.1",
    "postgrator": "8.0.0",
    "typebox": "1.3.30",
    "unleash-client": "6.12.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/archiver": "8.0.0",
    "@types/http-errors": "2.0.5",
    "@types/pg": "8.23.1",
    "@usebruno/cli": "4.1.0",
    "pino-pretty": "13.1.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "authors": [
    {
      "name": "Samuele Salvatico",
      "email": "samuele.salvatico@nearform.com"
    },
    {
      "name": "Matteo La Cognata",
      "email": "matteo.lacognata@nearform.com"
    }
  ]
}
