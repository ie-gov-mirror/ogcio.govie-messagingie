meta {
  name: Public Servant Can Select Profiles
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/profiles/select-profiles?ids={{firstListedProfileId}},{{secondListedProfileId}}
  body: none
  auth: bearer
}

params:query {
  ids: {{firstListedProfileId}},{{secondListedProfileId}}
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.data: isDefined
  res.body.data[0]: isDefined
  res.body.data[0].id: isDefined
}
