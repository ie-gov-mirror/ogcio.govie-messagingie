{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.*/**/*",
      "!**/node_modules/**/*",
      "!**/dist/**/*",
      "!**/out/**/*",
      "!**/coverage/**/*",
      "!**/playwright-report/**/*",
      "!**/next-env.d.ts",
      "!**/CHANGELOG.md",

      // Per-package exclusions: each one is scoped to its package path.
      // Generated OpenAPI types must stay byte-identical to the
      // `openapi-typescript` output, so no format run rewrites them.
      "!packages/api-types/**/*.d.ts",
      "!packages/bulk-seeder/*.json",
      "!apps/citizen-portal/**/scripts/static-content/fixtures/**/*",
      "!apps/citizen-portal/**/public/**/*",
      "!apps/citizen-portal/**/zones/**/*",
      "!apps/citizen-portal/**/e2e/**/*",
      "!apps/citizen-portal/**/k6/**/*",
      "!apps/citizen-portal/**/*.spec.*",
      "!apps/messaging-admin-next/**/public/**/*",
      "!apps/messaging-admin-next/**/test/**/*",
      "!apps/messaging-admin-next/**/k6/**/*",
      "!apps/messaging-support/**/public/**/*",
      "!apps/public-servant-portal/**/public/**/*"
    ]
  },
  "linter": {
    "enabled": true,
    "includes": ["**"],
    "rules": {
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "includes": ["**"],
    "attributePosition": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      // These packages use semicolons; the rest of the repo omits them.
      "includes": [
        "apps/messaging-api/**",
        "apps/profile-api/**",
        "apps/scheduler-api/**",
        "apps/upload-api/**",
        "packages/bulk-seeder/**",
        "packages/db-core/**"
      ],
      "javascript": {
        "formatter": {
          "semicolons": "always"
        }
      }
    },
    {
      // citizen-portal manages auth (sign-out/session) and locale cookies via
      // synchronous `document.cookie` writes. The suggested Cookie Store
      // API is async and unsupported in the browsers we target, so the
      // rule does not apply here.
      "includes": ["apps/citizen-portal/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      // Test doubles mimic third-party markup (Link as `<a href='#'>`,
      // spinner as `<span aria-label>`, constructor-returning mocks);
      // a11y rules target shipped UI, not mocks.
      "includes": [
        "apps/citizen-portal/**/*.test.*",
        "apps/citizen-portal/test/**"
      ],
      "linter": {
        "rules": {
          "a11y": "off",
          "correctness": { "noConstructorReturn": "off" }
        }
      }
    }
  ]
}
